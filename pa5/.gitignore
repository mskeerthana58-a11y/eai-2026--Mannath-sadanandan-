# Generated by the running services. The graded artefact is the code that
# produces these, not the files themselves.
order-service/data/*
!order-service/data/.gitkeep
payment-service/data/*
!payment-service/data/.gitkeep
inventory-service/data/*
!inventory-service/data/.gitkeep
notification-service/data/*
!notification-service/data/.gitkeep

# Never commit these.
node_modules/
tests/node_modules/
